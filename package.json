{
  "name": "gothere",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "A lighthearted, data-driven puzzle about getting there, no matter what",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=src/core/*.js --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 tests/*.test.mjs",
    "test:e2e": "node scripts/studio-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
